{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/LeoTN/PowerRules/main/assets/schema/powerrules_policy.schema.json",
    "title": "PowerRules Policy",
    "description": "Schema for PowerRules policy files.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "rules"
    ],
    "properties": {
        "rules": {
            "type": "array",
            "description": "Ordered list of rules. The first matching rule is executed.",
            "items": {
                "$ref": "#/$defs/rule"
            }
        }
    },
    "$defs": {
        "rule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "conditions",
                "action"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Human-readable name of the rule."
                },
                "enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether the rule is enabled."
                },
                "conditions": {
                    "$ref": "#/$defs/condition",
                    "description": "Condition that must be satisfied for the rule to match."
                },
                "action": {
                    "$ref": "#/$defs/action",
                    "description": "Action to perform when the rule matches."
                }
            }
        },
        "condition": {
            "type": "object",
            "oneOf": [
                {
                    "required": [
                        "and"
                    ],
                    "properties": {
                        "and": {
                            "type": "array",
                            "minItems": 2,
                            "description": "List of conditions that must all be satisfied.",
                            "items": {
                                "$ref": "#/$defs/condition"
                            }
                        }
                    }
                },
                {
                    "required": [
                        "or"
                    ],
                    "properties": {
                        "or": {
                            "type": "array",
                            "minItems": 2,
                            "description": "List of conditions where at least one must be satisfied.",
                            "items": {
                                "$ref": "#/$defs/condition"
                            }
                        }
                    }
                },
                {
                    "required": [
                        "not"
                    ],
                    "properties": {
                        "not": {
                            "$ref": "#/$defs/condition",
                            "description": "Condition that must not be satisfied."
                        }
                    }
                },
                {
                    "required": [
                        "process"
                    ],
                    "properties": {
                        "process": {
                            "$ref": "#/$defs/processCondition",
                            "description": "Condition based on the state of a process."
                        }
                    }
                },
                {
                    "required": [
                        "datetime"
                    ],
                    "properties": {
                        "datetime": {
                            "$ref": "#/$defs/dateTimeCondition",
                            "description": "Condition based on the current date or time."
                        }
                    }
                },
                {
                    "required": [
                        "window"
                    ],
                    "properties": {
                        "window": {
                            "$ref": "#/$defs/windowCondition",
                            "description": "Condition based on the presence of a window."
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "processCondition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "exists"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the process to check."
                },
                "exists": {
                    "type": "boolean",
                    "description": "Whether the process is expected to exist."
                },
                "match": {
                    "$ref": "#/$defs/match",
                    "description": "Defines how the process name should be matched."
                }
            }
        },
        "dateTimeCondition": {
            "type": "object",
            "description": "Matches if all configured criteria are satisfied. If several of 'between', 'weekday' and 'month' are configured, all of them must match.",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
                "between": {
                    "description": "Range during which the condition is satisfied. The start is inclusive and the end is exclusive. Use times of day for a range which repeats every day (it may cross midnight), or dates (optionally with a time) for a single absolute range. Both boundaries must be of the same kind.",
                    "oneOf": [
                        {
                            "$ref": "#/$defs/dateRange"
                        },
                        {
                            "$ref": "#/$defs/timeRange"
                        },
                        {
                            "$ref": "#/$defs/dateTimeRange"
                        }
                    ]
                },
                "weekday": {
                    "type": "array",
                    "minItems": 1,
                    "description": "List of weekdays on which the condition is satisfied. If the time range crosses midnight, the weekday refers to the day on which the range starts. For an absolute range, the weekday refers to the current day.",
                    "items": {
                        "$ref": "#/$defs/weekday"
                    }
                },
                "month": {
                    "type": "array",
                    "minItems": 1,
                    "description": "List of months in which the condition is satisfied. If the time range crosses midnight, the month refers to the day on which the range starts. For an absolute range, the month refers to the current day.",
                    "items": {
                        "$ref": "#/$defs/month"
                    }
                }
            }
        },
        "dateRange": {
            "type": "object",
            "additionalProperties": false,
            "description": "Absolute range between two dates. The whole days are covered starting at midnight.",
            "required": [
                "start",
                "end"
            ],
            "properties": {
                "start": {
                    "$ref": "#/$defs/date",
                    "description": "First date of the range (inclusive, starts at 0:00)."
                },
                "end": {
                    "$ref": "#/$defs/date",
                    "description": "End date of the range (exclusive, the range ends at 0:00 of this date)."
                }
            }
        },
        "date": {
            "type": "string",
            "description": "Date in YYYY-MM-DD format.",
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "timeRange": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "start",
                "end"
            ],
            "properties": {
                "start": {
                    "$ref": "#/$defs/time",
                    "description": "Start time of the range."
                },
                "end": {
                    "$ref": "#/$defs/time",
                    "description": "End time of the range."
                }
            }
        },
        "time": {
            "type": "string",
            "description": "Time in H, HH, H:MM, HH:MM, H:MM:SS, or HH:MM:SS format.",
            "pattern": "^(?:[0-9]|[01][0-9]|2[0-3])(?::[0-5][0-9](?::[0-5][0-9])?)?$"
        },
        "dateTimeRange": {
            "type": "object",
            "additionalProperties": false,
            "description": "Absolute range between two points in time without timezone.",
            "required": [
                "start",
                "end"
            ],
            "properties": {
                "start": {
                    "$ref": "#/$defs/dateTime",
                    "description": "Start of the range (inclusive)."
                },
                "end": {
                    "$ref": "#/$defs/dateTime",
                    "description": "End of the range (exclusive)."
                }
            }
        },
        "dateTime": {
            "type": "string",
            "description": "Date in YYYY-MM-DD format followed by a space or a T and a time in H, HH, H:MM, HH:MM, H:MM:SS, or HH:MM:SS format. Timezones are not supported.",
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[ T](?:[0-9]|[01][0-9]|2[0-3])(?::[0-5][0-9](?::[0-5][0-9])?)?$"
        },
        "weekday": {
            "type": "string",
            "description": "English case insensitive name of a weekday.",
            "pattern": "^(?:[Mm][Oo][Nn][Dd][Aa][Yy]|[Tt][Uu][Ee][Ss][Dd][Aa][Yy]|[Ww][Ee][Dd][Nn][Ee][Ss][Dd][Aa][Yy]|[Tt][Hh][Uu][Rr][Ss][Dd][Aa][Yy]|[Ff][Rr][Ii][Dd][Aa][Yy]|[Ss][Aa][Tt][Uu][Rr][Dd][Aa][Yy]|[Ss][Uu][Nn][Dd][Aa][Yy])$",
            "examples": [
                "Monday"
            ]
        },
        "month": {
            "type": "string",
            "description": "English case insensitive name of a month.",
            "pattern": "^(?:[Jj][Aa][Nn][Uu][Aa][Rr][Yy]|[Ff][Ee][Bb][Rr][Uu][Aa][Rr][Yy]|[Mm][Aa][Rr][Cc][Hh]|[Aa][Pp][Rr][Ii][Ll]|[Mm][Aa][Yy]|[Jj][Uu][Nn][Ee]|[Jj][Uu][Ll][Yy]|[Aa][Uu][Gg][Uu][Ss][Tt]|[Ss][Ee][Pp][Tt][Ee][Mm][Bb][Ee][Rr]|[Oo][Cc][Tt][Oo][Bb][Ee][Rr]|[Nn][Oo][Vv][Ee][Mm][Bb][Ee][Rr]|[Dd][Ee][Cc][Ee][Mm][Bb][Ee][Rr])$",
            "examples": [
                "January"
            ]
        },
        "windowCondition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "exists"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Title of the window to check."
                },
                "exists": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether the window is expected to exist."
                },
                "match": {
                    "$ref": "#/$defs/match",
                    "description": "Defines how the window title should be matched."
                }
            }
        },
        "match": {
            "type": "object",
            "additionalProperties": false,
            "description": "Defines how the value should be matched against the target. By default, an exact, case-sensitive match is used.",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "exact",
                        "regex"
                    ],
                    "default": "exact",
                    "description": "Whether the match should be exact or use a regular expression."
                },
                "case_sensitive": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether uppercase and lowercase letters should be treated differently."
                }
            }
        },
        "action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "shutdown",
                        "sleep",
                        "hibernate",
                        "reboot"
                    ],
                    "description": "Action to perform when the rule matches."
                }
            }
        }
    }
}